@model OrderPrintModel
@{
    Layout = "_PrintLayout";
    Order o = Model.Order;
    bool pick = Model.Kind == "picklist";
    ViewData["Title"] = (pick ? "Pick list " : "Order confirmation ") + o.OrderNumber;
    ViewData["BackUrl"] = Url.Action("Details", new { id = o.Id });
}

<div class="print-header">
    <div>
        <div class="print-company">Customer Order Management</div>
        <div class="muted">Internal operations</div>
    </div>
    <div class="print-doc">
        <div class="print-doc-title">@(pick ? "PICK LIST" : "ORDER CONFIRMATION")</div>
        <table class="def compact">
            <tr><th>Order</th><td class="mono">@o.OrderNumber</td></tr>
            <tr><th>Date</th><td>@o.OrderDate.ToString("yyyy-MM-dd")</td></tr>
            <tr><th>Required</th><td>@(o.RequiredDate?.ToString("yyyy-MM-dd"))</td></tr>
            <tr><th>Status</th><td>@o.Status</td></tr>
            <tr><th>Reference</th><td>@o.CustomerReference</td></tr>
        </table>
    </div>
</div>

<div class="print-addresses">
    <div>
        <div class="print-label">Customer</div>
        @if (Model.Customer != null)
        {
            <div><span class="mono">@Model.Customer.CustomerNumber</span> @Model.Customer.Name</div>
            <div>@Model.Customer.ContactName</div>
            <div>@Model.Customer.Email</div>
            <div>@Model.Customer.Phone</div>
        }
    </div>
    <div>
        <div class="print-label">Ship to</div>
        @if (o.ShipTo != null)
        {
            <div>@o.ShipTo.Line1</div>
            @if (!string.IsNullOrEmpty(o.ShipTo.Line2)) { <div>@o.ShipTo.Line2</div> }
            <div>@o.ShipTo.City @o.ShipTo.Region @o.ShipTo.PostalCode</div>
            <div>@o.ShipTo.Country</div>
        }
    </div>
</div>

<table class="grid print-lines">
    <thead>
        <tr>
            <th class="num">#</th>
            <th>SKU</th>
            <th>Description</th>
            <th class="num">Qty</th>
            @if (pick)
            {
                <th class="num">Picked</th>
                <th>Location / notes</th>
            }
            else
            {
                <th class="num">Unit price</th>
                <th class="num">Disc %</th>
                <th class="num">Line total</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (OrderLine l in o.Lines)
        {
            <tr>
                <td class="num">@l.LineNumber</td>
                <td class="mono">@l.Sku</td>
                <td>@l.Description</td>
                <td class="num">@l.Quantity.ToString("0.###")</td>
                @if (pick)
                {
                    <td class="num pick-box">&nbsp;</td>
                    <td class="pick-box">&nbsp;</td>
                }
                else
                {
                    <td class="num">@l.UnitPrice.ToString("N2")</td>
                    <td class="num">@(l.DiscountPercent == 0 ? "" : l.DiscountPercent.ToString("0.##"))</td>
                    <td class="num">@l.LineTotal.ToString("N2")</td>
                }
            </tr>
        }
    </tbody>
    @if (!pick)
    {
        <tfoot>
            <tr><td colspan="6" class="num">Subtotal</td><td class="num">@o.Subtotal.ToString("N2")</td></tr>
            <tr><td colspan="6" class="num">Tax (@((o.TaxRate * 100).ToString("0.##"))%)</td><td class="num">@o.TaxAmount.ToString("N2")</td></tr>
            <tr class="total"><td colspan="6" class="num">Total</td><td class="num">@o.Total.ToString("N2")</td></tr>
        </tfoot>
    }
</table>

@if (pick)
{
    <div class="print-signoff">
        <div>Picked by: ______________________</div>
        <div>Checked by: ______________________</div>
        <div>Date: ______________</div>
    </div>
}
else if (!string.IsNullOrEmpty(o.Notes))
{
    <div class="print-notes"><div class="print-label">Notes</div><div class="pre">@o.Notes</div></div>
}

<div class="print-footer">Printed @DateTime.Now.ToString("yyyy-MM-dd HH:mm") by @User.Identity?.Name</div>
