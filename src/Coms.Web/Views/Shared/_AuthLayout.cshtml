@inject AppInfo App
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Order Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <span class="topbar-title">Customer Order Management</span>
    </header>

    <div class="frame">
        <main class="content auth-content">
            <div class="auth-panel">
                <h1 class="page-title">@ViewData["Title"]</h1>
                @RenderBody()
            </div>
        </main>
    </div>

    <footer class="statusbar">
        <span>Environment: @App.EnvironmentName</span>
        <span>Database: @App.DatabaseName</span>
        <span>Version: @App.Version</span>
    </footer>
</body>
</html>
