@model Customer

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="RowVersion" />

<div class="columns">
    <section class="panel">
        <h2>Customer</h2>
        <div class="form-grid">
            <label asp-for="Name">Name *</label>
            <div><input asp-for="Name" maxlength="200" /><span asp-validation-for="Name" class="field-error"></span></div>

            <label asp-for="ContactName">Contact</label>
            <div><input asp-for="ContactName" maxlength="100" /><span asp-validation-for="ContactName" class="field-error"></span></div>

            <label asp-for="Email">Email</label>
            <div><input asp-for="Email" maxlength="254" /><span asp-validation-for="Email" class="field-error"></span></div>

            <label asp-for="Phone">Phone</label>
            <div><input asp-for="Phone" maxlength="30" /><span asp-validation-for="Phone" class="field-error"></span></div>

            <label asp-for="PaymentTermsDays">Payment terms (days) *</label>
            <div><input asp-for="PaymentTermsDays" type="number" min="0" max="365" class="short" /><span asp-validation-for="PaymentTermsDays" class="field-error"></span></div>

            <label asp-for="CreditLimit">Credit limit</label>
            <div><input asp-for="CreditLimit" type="number" step="0.01" min="0" class="short" /><span asp-validation-for="CreditLimit" class="field-error"></span></div>

            <label asp-for="Status">Status *</label>
            <div>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<CustomerStatus>()"></select>
                <span asp-validation-for="Status" class="field-error"></span>
            </div>

            <label asp-for="Notes">Notes</label>
            <div><textarea asp-for="Notes" rows="3"></textarea></div>
        </div>
    </section>

    <section class="panel">
        <h2>Billing address</h2>
        <div class="form-grid">
            <label asp-for="BillingAddress.Line1">Line 1 *</label>
            <div><input asp-for="BillingAddress.Line1" maxlength="100" /><span asp-validation-for="BillingAddress.Line1" class="field-error"></span></div>
            <label asp-for="BillingAddress.Line2">Line 2</label>
            <div><input asp-for="BillingAddress.Line2" maxlength="100" /></div>
            <label asp-for="BillingAddress.City">City *</label>
            <div><input asp-for="BillingAddress.City" maxlength="80" /><span asp-validation-for="BillingAddress.City" class="field-error"></span></div>
            <label asp-for="BillingAddress.Region">Region</label>
            <div><input asp-for="BillingAddress.Region" maxlength="80" /></div>
            <label asp-for="BillingAddress.PostalCode">Postal code</label>
            <div><input asp-for="BillingAddress.PostalCode" maxlength="20" class="short" /></div>
            <label asp-for="BillingAddress.Country">Country *</label>
            <div><input asp-for="BillingAddress.Country" maxlength="60" /><span asp-validation-for="BillingAddress.Country" class="field-error"></span></div>
        </div>

        <h2>Shipping address <span class="muted">(leave blank if same as billing)</span></h2>
        <div class="form-grid">
            <label asp-for="ShippingAddress!.Line1">Line 1</label>
            <div><input asp-for="ShippingAddress!.Line1" maxlength="100" /><span asp-validation-for="ShippingAddress!.Line1" class="field-error"></span></div>
            <label asp-for="ShippingAddress!.Line2">Line 2</label>
            <div><input asp-for="ShippingAddress!.Line2" maxlength="100" /></div>
            <label asp-for="ShippingAddress!.City">City</label>
            <div><input asp-for="ShippingAddress!.City" maxlength="80" /><span asp-validation-for="ShippingAddress!.City" class="field-error"></span></div>
            <label asp-for="ShippingAddress!.Region">Region</label>
            <div><input asp-for="ShippingAddress!.Region" maxlength="80" /></div>
            <label asp-for="ShippingAddress!.PostalCode">Postal code</label>
            <div><input asp-for="ShippingAddress!.PostalCode" maxlength="20" class="short" /></div>
            <label asp-for="ShippingAddress!.Country">Country</label>
            <div><input asp-for="ShippingAddress!.Country" maxlength="60" /><span asp-validation-for="ShippingAddress!.Country" class="field-error"></span></div>
        </div>
    </section>
</div>
