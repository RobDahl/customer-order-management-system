@model Customer
@{
    ViewData["Title"] = "Edit " + Model.CustomerNumber;
    ViewData["Nav"] = "Customers";
    ViewData["Breadcrumb"] = "<a href=\"" + Url.Action("Index") + "\">Customers</a> &rsaquo; <a href=\"" + Url.Action("Details", new { id = Model.Id }) + "\">" + Model.CustomerNumber + "</a> &rsaquo; Edit";
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <partial name="_CustomerForm" model="Model" />
    <div class="form-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn">Cancel</a>
        <button type="submit" class="primary">Save</button>
    </div>
</form>
