@model SalesByMonthModel
@{
    ViewData["Title"] = "Sales by month";
    ViewData["Nav"] = "Reports";
    ViewData["Breadcrumb"] = "<a href=\"" + Url.Action("Index") + "\">Reports</a> &rsaquo; Sales by month";
    decimal max = Model.Rows.Count == 0 ? 0 : Model.Rows.Max(r => r.Total);
}

<div class="toolbar">
    <form method="get" class="filters">
        <partial name="_PeriodFilter" model="Model" />
        <button type="submit">Run</button>
    </form>
    <div class="toolbar-actions">
        <a asp-action="SalesByMonth" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-format="csv" class="btn">Export CSV</a>
    </div>
</div>
<div asp-validation-summary="All" class="validation-summary"></div>

<table class="grid bars">
    <thead><tr><th>Month</th><th class="num">Orders</th><th class="num">Subtotal</th><th class="num">Tax</th><th class="num">Total</th><th class="num">Average order</th><th class="bar-col"></th></tr></thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="mono">@r.MonthLabel</td>
                <td class="num">@r.OrderCount</td>
                <td class="num">@r.Subtotal.ToString("N2")</td>
                <td class="num">@r.TaxAmount.ToString("N2")</td>
                <td class="num">@r.Total.ToString("N2")</td>
                <td class="num">@r.AverageOrderValue.ToString("N2")</td>
                <td class="bar-col"><div class="bar" style="width: @(max == 0 ? 0 : (int)(r.Total * 100 / max))%"></div></td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="total">
            <td>Total</td>
            <td class="num">@Model.Rows.Sum(r => r.OrderCount)</td>
            <td class="num">@Model.Rows.Sum(r => r.Subtotal).ToString("N2")</td>
            <td class="num">@Model.Rows.Sum(r => r.TaxAmount).ToString("N2")</td>
            <td class="num">@Model.Rows.Sum(r => r.Total).ToString("N2")</td>
            <td></td><td></td>
        </tr>
    </tfoot>
</table>
