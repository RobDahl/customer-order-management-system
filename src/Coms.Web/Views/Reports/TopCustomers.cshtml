@model TopCustomersModel
@{
    ViewData["Title"] = "Top customers";
    ViewData["Nav"] = "Reports";
    ViewData["Breadcrumb"] = "<a href=\"" + Url.Action("Index") + "\">Reports</a> &rsaquo; Top customers";
}

<div class="toolbar">
    <form method="get" class="filters">
        <partial name="_PeriodFilter" model="Model" />
        <label for="Top">Top</label>
        <input type="number" id="Top" name="top" value="@Model.Top" min="1" max="100" class="short" />
        <button type="submit">Run</button>
    </form>
    <div class="toolbar-actions">
        <a asp-action="TopCustomers" asp-route-from="@Model.From?.ToString("yyyy-MM-dd")" asp-route-to="@Model.To?.ToString("yyyy-MM-dd")" asp-route-top="@Model.Top" asp-route-format="csv" class="btn">Export CSV</a>
    </div>
</div>
<div asp-validation-summary="All" class="validation-summary"></div>

<table class="grid">
    <thead><tr><th class="num">#</th><th>Customer</th><th>Status</th><th class="num">Orders</th><th class="num">Sales</th><th class="num">Average order</th><th class="num">Share %</th><th>Last order</th></tr></thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="num">@r.Rank</td>
                <td><a asp-controller="Customers" asp-action="Details" asp-route-id="@r.CustomerId"><span class="mono">@r.CustomerNumber</span> @r.CustomerName</a></td>
                <td class="status-@r.Status.ToLowerInvariant()">@r.Status</td>
                <td class="num">@r.OrderCount</td>
                <td class="num">@r.Total.ToString("N2")</td>
                <td class="num">@r.AverageOrderValue.ToString("N2")</td>
                <td class="num">@r.SharePercent.ToString("0.00")</td>
                <td class="date">@r.LastOrderDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="8" class="muted">No sales in this period.</td></tr>
        }
    </tbody>
</table>
