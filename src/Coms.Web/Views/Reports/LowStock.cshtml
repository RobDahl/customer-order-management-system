@model LowStockModel
@{
    ViewData["Title"] = "Low stock";
    ViewData["Nav"] = "Reports";
    ViewData["Breadcrumb"] = "<a href=\"" + Url.Action("Index") + "\">Reports</a> &rsaquo; Low stock";
}

<div class="toolbar">
    <p class="muted">Active products whose quantity on hand, less demand from submitted and approved orders, is at or below the reorder level.</p>
    <div class="toolbar-actions">
        <a asp-action="LowStock" asp-route-format="csv" class="btn">Export CSV</a>
    </div>
</div>

<table class="grid">
    <thead><tr><th>SKU</th><th>Product</th><th>Category</th><th class="num">On hand</th><th class="num">Pending demand</th><th class="num">Projected</th><th class="num">Reorder level</th><th class="num">Shortfall</th></tr></thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td class="mono"><a asp-controller="Products" asp-action="Details" asp-route-id="@r.ProductId">@r.Sku</a></td>
                <td>@r.Name</td>
                <td>@r.Category</td>
                <td class="num">@r.QuantityOnHand.ToString("0.###") @r.UnitOfMeasure</td>
                <td class="num">@r.PendingDemand.ToString("0.###")</td>
                <td class="num @(r.ProjectedOnHand < 0 ? "err" : "warn")">@r.ProjectedOnHand.ToString("0.###")</td>
                <td class="num">@r.ReorderLevel.ToString("0.###")</td>
                <td class="num">@r.Shortfall.ToString("0.###")</td>
            </tr>
        }
        @if (Model.Rows.Count == 0)
        {
            <tr><td colspan="8" class="muted">Nothing below reorder level.</td></tr>
        }
    </tbody>
</table>
