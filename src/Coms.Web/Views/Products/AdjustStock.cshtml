@model StockAdjustmentModel
@{
    ViewData["Title"] = "Adjust stock " + Model.Sku;
    ViewData["Nav"] = "Products";
    ViewData["Breadcrumb"] = "<a href=\"" + Url.Action("Index") + "\">Products</a> &rsaquo; <a href=\"" + Url.Action("Details", new { id = Model.Id }) + "\">" + Model.Sku + "</a> &rsaquo; Adjust stock";
}

<form asp-action="AdjustStock" method="post" class="narrow">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RowVersion" />
    <input type="hidden" asp-for="Sku" />
    <input type="hidden" asp-for="Name" />
    <input type="hidden" asp-for="UnitOfMeasure" />
    <input type="hidden" asp-for="CurrentQuantity" />

    <section class="panel">
        <div class="form-grid">
            <label>Product</label>
            <div><span class="mono">@Model.Sku</span> @Model.Name</div>

            <label>Current quantity</label>
            <div class="num">@Model.CurrentQuantity.ToString("0.###") @Model.UnitOfMeasure</div>

            <label asp-for="NewQuantity">Counted quantity *</label>
            <div><input asp-for="NewQuantity" type="number" step="0.001" class="short" autofocus /><span asp-validation-for="NewQuantity" class="field-error"></span></div>

            <label asp-for="Reason">Reason *</label>
            <div><input asp-for="Reason" maxlength="200" placeholder="e.g. Stock count 2026-09" /><span asp-validation-for="Reason" class="field-error"></span></div>
        </div>
    </section>

    <div class="form-actions">
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn">Cancel</a>
        <button type="submit" class="primary">Save adjustment</button>
    </div>
</form>
